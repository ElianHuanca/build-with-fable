[Unit]
Description=Dengue Invaders - servicio de inferencia (detector + clasificador de mosquitos)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/admin/build-with-fable/ml/pi
ExecStart=/home/admin/build-with-fable/ml/pi/venv/bin/gunicorn --workers 2 --preload --timeout 60 --bind 0.0.0.0:8080 servidor:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
